  "domainProduct": {
    "home": "Hospital Transparency Control Room",
    "context": "A compliance operating system for CMS machine-readable files, payer-rate completeness, allowed-amount statistics, executive attestation, and enforcement response.",
    "features": [
      {
        "id": "file-certification",
        "title": "MRF Certification Pipeline",
        "description": "Ingest, validate, remediate, and certify every hospital machine-readable file before publication.",
        "view": "evidence",
        "modules": [
          "mrf-ingestion",
          "hospital-registry"
        ],
        "actions": [
          {
            "id": "accept-schema",
            "label": "Accept CMS Schema",
            "nextStatus": "Approved",
            "auditDetail": "Accepted CMS template and required hospital identity fields."
          },
          {
            "id": "reject-file",
            "label": "Reject Nonconforming File",
            "nextStatus": "Investigating",
            "auditDetail": "Rejected file for structural or accessibility remediation."
          }
        ]
      },
      {
        "id": "rate-integrity",
        "title": "Negotiated Rate Integrity",
        "description": "Reconcile payer plans, billing codes, service settings, negotiated charges, and missing-rate populations.",
        "view": "reconciliation",
        "modules": [
          "rate-completeness",
          "payer-plan-master"
        ],
        "actions": [
          {
            "id": "approve-completeness",
            "label": "Approve Rate Completeness",
            "nextStatus": "Approved",
            "auditDetail": "Approved payer-plan and billing-code population completeness."
          },
          {
            "id": "open-rate-gap",
            "label": "Open Missing-Rate Case",
            "nextStatus": "Investigating",
            "auditDetail": "Opened a missing or unsupported payer-rate exception."
          }
        ]
      },
      {
        "id": "allowed-statistics",
        "title": "Allowed-Amount Statistics Control",
        "description": "Validate median, 10th and 90th percentiles and observation counts for algorithm-based rates.",
        "view": "control",
        "modules": [
          "allowed-amounts",
          "billing-code-master"
        ],
        "actions": [
          {
            "id": "validate-statistics",
            "label": "Validate Allowed Statistics",
            "nextStatus": "Approved",
            "auditDetail": "Validated allowed-amount percentile and observation-count evidence."
          },
          {
            "id": "quarantine-statistics",
            "label": "Quarantine Invalid Statistics",
            "nextStatus": "Review",
            "auditDetail": "Quarantined invalid or unsupported allowed-amount statistics."
          }
        ]
      },
      {
        "id": "executive-attestation",
        "title": "Executive Attestation",
        "description": "Aggregate unresolved exceptions and evidence supporting the authorized official's certification.",
        "view": "board",
        "modules": [
          "attestation",
          "cms-control-library"
        ],
        "actions": [
          {
            "id": "release-attestation",
            "label": "Release for Signature",
            "nextStatus": "Review",
            "auditDetail": "Released complete attestation evidence for authorized signature."
          },
          {
            "id": "block-attestation",
            "label": "Block Attestation",
            "nextStatus": "Investigating",
            "auditDetail": "Blocked attestation because material exceptions remain open."
          }
        ]
      },
      {
        "id": "cms-enforcement",
        "title": "CMS Enforcement & CAP",
        "description": "Control notices, corrective action plans, deadlines, evidence submissions, and closure receipts.",
        "view": "deadline",
        "modules": [
          "enforcement",
          "accessibility"
        ],
        "actions": [
          {
            "id": "submit-cap",
            "label": "Submit Corrective Action Plan",
            "nextStatus": "Review",
            "auditDetail": "Submitted corrective action plan and supporting evidence."
          },
          {
            "id": "close-enforcement",
            "label": "Close Enforcement Matter",
            "nextStatus": "Approved",
            "auditDetail": "Closed the enforcement matter after CMS response validation."
          }
        ]
      }
    ]
  },
